@startuml CASOS_USO_SI
title Casos de uso — Sistema interno (SI) — SIGEL / Travel BQTO

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam actor {
  BackgroundColor white
  BorderColor black
}
skinparam usecase {
  BackgroundColor white
  BorderColor black
}
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor black
  FontStyle plain
}
skinparam arrow {
  Color black
}
skinparam note {
  BackgroundColor #FFFFCC
  BorderColor black
}
skinparam linetype polyline

actor "Cliente interno\n(CI)" as CI
actor "Administrador" as ADM
actor "Guía" as GUI

ADM --|> CI

package "Catálogo" {
  usecase "Gestionar destinos\n(RF-04)" as UC04
  usecase "Gestionar flota\ny croquis (RF-16)" as UC16
  usecase "Gestionar puntos\nde recogida (RF-07)" as UC07
}

package "Planificación" {
  usecase "Planificar viajes\n(RF-18)" as UC18
  usecase "Estructurar costos\n(RF-06)" as UC06
  usecase "Asignar guías\n(RF-10)" as UC10
  usecase "Definir ruta\nde recogida (RF-07)" as UC07B
}

package "Comercial" {
  usecase "Gestionar clientes\n(RF-11)" as UC11
  usecase "Gestionar reservas\n(RF-12, RF-01)" as UC12
  usecase "Gestionar cotizaciones\n(RF-05)" as UC05
  usecase "Conciliar pagos\n(RF-09)" as UC09
  usecase "Moderar reseñas\n(RF-08)" as UC08
}

package "Operación en campo" {
  usecase "Consultar viajes\nasignados (RF-10)" as UC10B
  usecase "Registrar abordaje\n(RF-03)" as UC03
  usecase "Consultar manifiesto\ny listín" as UC03B
}

package "Análisis" {
  usecase "Consultar reportes\nestadísticos (RF-15)" as UC15
}

package "Componente inteligente" {
  usecase "Consultar asistente\ninteligente (RCI)" as UCRCI
  usecase "Evaluar rentabilidad\ny reglas (RCI-01)" as UCRCI01
  usecase "Rankear destinos\n(RCI-02)" as UCRCI02
  usecase "Detectar demanda\nestacional (RCI-03)" as UCRCI03
}

usecase "Exportar reporte\nPDF / Excel" as UCEXP

CI --> UC04
CI --> UC11
CI --> UC12
CI --> UC05
CI --> UC07

ADM --> UC16
ADM --> UC18
ADM --> UC06
ADM --> UC10
ADM --> UC07B
ADM --> UC09
ADM --> UC08
ADM --> UC15
ADM --> UCEXP
ADM --> UCRCI

UCRCI .> UCRCI01 : <<include>>
UCRCI .> UCRCI02 : <<include>>
UCRCI .> UCRCI03 : <<include>>

GUI --> UC10B
GUI --> UC03
GUI --> UC03B
GUI --> UCEXP

UC18 .> UC06 : <<include>>
UC18 .> UC10 : <<include>>
UC18 .> UC07B : <<include>>
UCEXP .> UC15 : <<extend>>
UCEXP .> UC03B : <<extend>>

note as N1
  Precondición: sesión en el SI
  y permiso del módulo
  (crear_ / leer_ / editar_ / borrar_).

  «Gestionar» no se explota en
  cuatro óvalos. El CRUD está
  en CASOS_USO_SEGURIDAD.

  En el código sembrado:
  · Administrador: todos los módulos
  · Guía: leer planificación,
    reservas, clientes y puntos;
    crear/leer/editar abordaje
  · CI adicional (p. ej. Atención
    al cliente): rol creado en
    Usuarios y roles, con el
    subconjunto de permisos que
    asigne el Administrador
end note
@enduml
