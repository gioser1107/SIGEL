@startuml
title Secuencia — Registrar reserva (portal del cliente)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 0
skinparam sequence {
  ArrowColor black
  ActorBorderColor black
  ActorBackgroundColor white
  LifeLineBorderColor black
  ParticipantBorderColor black
  ParticipantBackgroundColor white
  GroupBorderColor black
  GroupBackgroundColor white
}
skinparam database {
  BackgroundColor white
  BorderColor black
}
hide footbox
autonumber

actor "Cliente" as cliente
boundary "vistaReserva :\nInterfazReserva" as vista
control "ctrlReservas :\nReservasControlador" as ctrl
control "modeloReservas :\nReservasModelo" as modelo
database "bd : MySQL" as bd
entity "bitacora :\nBitacora" as bitacora

cliente -> vista : Completar viaje, titular,\nacompañantes, puntos y asientos
activate vista
cliente -> vista : Pulsar Confirmar
vista -> vista : Validar campos del formulario

alt ¿Los datos de la interfaz son válidos?
  vista -> ctrl : POST /api/reservas/cliente\n(JWT + datos)
  activate ctrl
  ctrl -> ctrl : Verificar token, rol y perfil

  alt ¿La sesión y el perfil son válidos?
    ctrl -> modelo : crearReservaDesdeLanding(...)
    activate modelo
    modelo -> bd : Consultar y bloquear\ncliente, viaje, cupo y asientos
    activate bd
    bd --> modelo : Datos actuales
    deactivate bd

    alt ¿Se cumplen las reglas de negocio?
      modelo -> bd : Guardar reserva, viajeros y asientos
      activate bd
      bd --> modelo : reserva (id)
      deactivate bd
      modelo --> ctrl : reserva
      deactivate modelo

      ctrl -> bitacora : registrarEvento(usuario,\nmódulo reservas, INSERT, id)
      activate bitacora
      bitacora -> bd : Guardar bitácora
      activate bd
      bd --> bitacora : ok
      deactivate bd
      bitacora --> ctrl : auditoría ok
      deactivate bitacora

      ctrl --> vista : 200 + reserva_id
      deactivate ctrl
      vista --> cliente : Mostrar RES-id
    else no
      modelo --> ctrl : error 400 / 404 / 409 / 422
      deactivate modelo
      ctrl --> vista : detalle del error
      deactivate ctrl
      vista --> cliente : Mostrar el motivo
    end
  else no
    ctrl --> vista : error 401 / 403
    deactivate ctrl
    vista --> cliente : Pedir inicio de sesión
  end
else no
  vista --> cliente : Indicar campos a corregir
end

deactivate vista
@enduml
