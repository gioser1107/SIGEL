@startuml
title Actividad — Consultar reporte estadístico

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 15
skinparam activity {
  BackgroundColor white
  BorderColor black
  DiamondBackgroundColor white
  DiamondBorderColor black
  StartColor black
  EndColor black
  ArrowColor black
  FontColor black
}
skinparam partition {
  BorderColor black
  FontColor black
  BackgroundColor white
  FontStyle bold
}

|Administrador|
start
:Abrir reportes estadísticos;
:Indicar fecha desde y hasta reales;
:Pulsar Consultar;

|Interfaz|
:Validar que las fechas se puedan enviar;
if (¿Fechas completas?) then (sí)
  :Enviar la consulta\ncon el token;
else (no)
  :Mostrar las fechas a corregir;
  |Administrador|
  :Corregir el rango;
  stop
endif

|Controlador|
:Validar token y permiso de lectura;
if (¿Sesión y permiso válidos?) then (sí)
  :Solicitar el reporte;
else (no)
  |Interfaz|
  :Mostrar error de acceso;
  |Administrador|
  :Visualizar el rechazo;
  stop
endif

|Modelo|
:Validar rango real\n(año, orden y máximo 10 años);
if (¿El rango es válido?) then (sí)
  :Pedir los indicadores del período;
else (no)
  |Interfaz|
  :Mostrar la regla de fechas;
  |Administrador|
  :Visualizar el motivo;
  stop
endif

|MySQL|
:Consultar clientes, reservas,\ndestinos, movimiento e ingresos;

|Modelo|
:Armar el reporte descriptivo;

|Controlador|
:Responder los indicadores;

|Interfaz|
:Mostrar e imprimir el reporte;

|Administrador|
:Visualizar el resultado;
stop
@enduml
